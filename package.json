{
  "name": "rendecrew",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "prisma generate && node scripts/fix-data-model-erd-svg.mjs",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "prisma:push:session": "node scripts/prisma-db-push.cjs",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:dev:session": "node scripts/prisma-migrate-dev.cjs",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:deploy:session": "node scripts/prisma-migrate-deploy.cjs",
    "prisma:baseline:resolve-applied": "node scripts/prisma-baseline-resolve-applied.cjs",
    "prisma:format": "prisma format",
    "verify:data-model-erd": "npm run prisma:generate && git diff --exit-code docs/data-model-svgs/data-model-full-erd.svg docs/data-model-svgs/core-data-model-erd.svg docs/data-model-svgs/packing-data-model-erd.svg docs/data-model-svgs/rides-data-model-erd.svg docs/data-model-svgs/tasks-data-model-erd.svg docs/data-model-svgs/notifications-data-model-erd.svg",
    "puppeteer:install-chrome": "puppeteer browsers install chrome-headless-shell",
    "fix:data-model-erd-svg": "node scripts/fix-data-model-erd-svg.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@clerk/nextjs": "^5.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@liveblocks/client": "^3.15.5",
    "@liveblocks/node": "^3.15.5",
    "@liveblocks/react": "^3.15.5",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.3.0",
    "luxon": "^3.7.2",
    "next": "^14.2.0",
    "prisma": "^7.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.2.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.38",
    "prettier": "^3.8.1",
    "prisma-erd-generator": "^2.4.2",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vitest": "^4.1.2"
  }
}
